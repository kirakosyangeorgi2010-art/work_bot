# Скопируйте этот файл в .env и заполните.

# Токен бота от @BotFather
TELEGRAM_TOKEN=

# Ваш Telegram ID (бот пришлёт его на /start). Бот отвечает только вам.
OWNER_ID=

# Ключ Gemini из https://aistudio.google.com/apikey (запасной ИИ)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Какой ИИ пробовать первым: claude или gemini
AI_ORDER=claude
# Модель Claude: sonnet (лучше пишет) или haiku (быстрее, меньше тратит лимит). Пусто = по умолчанию
CLAUDE_MODEL=sonnet

# Файл ниши из папки niches (без .json)
NICHE=beauty_salons
# Сколько готовых салонов держать в очереди
QUEUE_SIZE=5
